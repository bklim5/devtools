<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Phase 26 minimal App Sandbox harness (D-12). App-sandbox + network.client +
    the StoreKit-binding identifiers — nothing speculative. NO Keychain-group
    entitlement, NO user-selected-file entitlement, NO other speculative
    entitlements (26-RESEARCH anti-pattern). The formal store entitlement set is
    Phase 27.

    Distinct from the direct-channel entitlements.plist (the hardened-runtime
    JIT / unsigned-memory / library-validation exceptions) — those are
    Developer-ID hardened-runtime exceptions and have NO place in a sandboxed MAS
    build.
  -->

  <!-- com.apple.security.app-sandbox: mandatory for the Mac App Store. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>

  <!--
    com.apple.security.network.client: MANDATORY, not a feature. The WKWebview's
    Tauri IPC rides this; without it the sandboxed webview white-screens
    (26-RESEARCH Pitfall 2). It is also the ONLY outbound the StoreKit path needs
    (Apple's StoreKit servers) — the static + live D-04 audits prove zero
    non-Apple use of it.
  -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!--
    com.apple.application-identifier + team-identifier: REQUIRED for StoreKit to
    bind this build to the App Store Connect record (without application-identifier
    the sandbox loads NO products / a purchase cannot complete). Value =
    <TeamID>.<bundle-id>. These also make the entitlements provisioning-profile-
    restricted, so the signed sandboxed .app MUST carry an embedded Mac App Store
    provisioning profile for `com.tinkerdev.app` (Tauri 2.x has no provisioningProfile
    config key — scripts/build-appstore-spike.sh embeds it + re-signs).
  -->
  <key>com.apple.application-identifier</key>
  <string>FK4HQK83WX.com.tinkerdev.app</string>
  <key>com.apple.developer.team-identifier</key>
  <string>FK4HQK83WX</string>
</dict>
</plist>
