# Copy to .env (gitignored) and fill — consumed by scripts/build.sh for signed
# builds so you don't have to export these in a separate terminal each session.
# Only the `direct` target (release:build-only DMG) needs these; the appstore
# and appstore-pkg targets sign from keychain certs + the embedded profile.
# NEVER commit .env.

# Direct-channel updater signing (Tauri minisign keypair)
TAURI_SIGNING_PRIVATE_KEY=
# ...or a path instead of the inline key:
# TAURI_SIGNING_PRIVATE_KEY_PATH=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Apple notarisation (App Store Connect API key set)
APPLE_API_KEY_PATH=
APPLE_API_KEY=
APPLE_API_ISSUER=

# Developer ID Application identity for the direct DMG (e.g. "Developer ID Application: Your Name (TEAMID)")
APPLE_SIGNING_IDENTITY=